# NeuroCinema Backend — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# API Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# CORS — Frontend URL
FRONTEND_URL=http://localhost:5173

# Data paths
DATA_DIR=./data
PREDICTIONS_DIR=./data/predictions
SURFACE_DIR=./data/surface
REGIONS_DIR=./data/regions